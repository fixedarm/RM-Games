# Server-side (Netlify env vars) — never ship these in the app
GEMINI_API_KEY=your-key-from-aistudio.google.com
GEMINI_MODEL=gemini-2.5-flash
# Comma-separated origins allowed to call /api/advisor (web domain + Android WebView)
ALLOWED_ORIGINS=https://your-site.netlify.app,https://localhost,capacitor://localhost

# Client-side: absolute API URL, required for the Android build (leave empty for web)
VITE_API_BASE=https://your-site.netlify.app
